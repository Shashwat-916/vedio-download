{
  "name": "youtube-hd-downloader",
  "version": "1.0.0",
  "description": "High-performance TypeScript YouTube video downloader using yt-dlp and FFmpeg to extract and merge best audio & video streams.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsc -b && node dist/index.js"
  },
  "keywords": [
    "youtube",
    "downloader",
    "yt-dlp",
    "ffmpeg",
    "typescript",
    "video-downloader",
    "audio-merger"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}

